# JSON access logs to stdout, where the Alloy shipper picks them up into Loki.
(accesslog) {
	log {
		output stdout
		format json
	}
}

yourweatherapp.fi {
	import accesslog
	encode gzip zstd
	reverse_proxy web:4321
}

logs.yourweatherapp.fi {
	import accesslog
	encode gzip zstd
	reverse_proxy grafana:3000
}

api.yourweatherapp.fi {
	import accesslog
	encode gzip zstd
	root * /srv

	# Don't log the uptime/health probe.
	@health path /health
	log_skip @health

	@api path /v1/* /health
	handle @api {
		reverse_proxy server:{$PORT}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
