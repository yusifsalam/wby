# Shared infrastructure config (used by infra/docker-compose.yml).
# Copy to infra/.env and fill in secrets.

# Grafana (observability stack — profile "logging")
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Direct host access (reachable without Caddy). Localhost-only by default; set
# GRAFANA_BIND=0.0.0.0 to expose the port on all interfaces.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
# Public URL Grafana serves under. Localhost for direct/dev access; set to
# https://logs.yourweatherapp.fi when running behind Caddy in production.
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_LOG_LEVEL=warn
