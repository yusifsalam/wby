---
// Cycles the color theme auto → light → dark. The resolved .dark class and the
// data-theme-setting attribute are first set by the inline script in
// BaseLayout so the correct icon shows without a flash.
---

<button
  id="theme-toggle"
  type="button"
  class="flex-none rounded-lg border border-transparent p-2 text-muted hover:border-line hover:bg-surface hover:text-ink"
  aria-label="Toggle color theme"
  title="Color theme"
>
  <svg class="theme-icon theme-icon--auto h-4.5 w-4.5" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="9" fill="none" />
    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none" />
  </svg>
  <svg class="theme-icon theme-icon--light h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
  </svg>
  <svg class="theme-icon theme-icon--dark h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<script>
  const KEY = "theme";
  const root = document.documentElement;
  const mq = window.matchMedia("(prefers-color-scheme: dark)");

  function resolveDark(setting: string) {
    return setting === "dark" || (setting !== "light" && mq.matches);
  }

  function apply(setting: string) {
    root.dataset.themeSetting = setting;
    root.classList.toggle("dark", resolveDark(setting));
  }

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const order = ["auto", "light", "dark"];
    const current = localStorage.getItem(KEY) ?? "auto";
    const next = order[(order.indexOf(current) + 1) % order.length];
    if (next === "auto") localStorage.removeItem(KEY);
    else localStorage.setItem(KEY, next);
    apply(next);
  });

  // Track the OS setting while in auto mode.
  mq.addEventListener("change", () => {
    if ((localStorage.getItem(KEY) ?? "auto") === "auto") apply("auto");
  });
</script>
