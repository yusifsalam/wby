---
import type { City } from "../lib/cities";
import TopBar from "./TopBar.astro";

type Props = {
  cities: readonly City[];
  title: string;
  message: string;
};

const { cities, title, message } = Astro.props;
---

<main class="mx-auto w-[min(1180px,100%)] p-6 max-[820px]:p-4">
  <TopBar cities={cities} />
  <section class="grid min-h-[420px] justify-items-center gap-3 px-5 py-20 text-center">
    <img class="h-24 w-24" src="/wby-weather.svg" alt="" />
    <h1 class="mb-0 text-[clamp(2rem,7vw,4.5rem)] font-bold">{title}</h1>
    <p class="max-w-[52ch] text-muted">{message}</p>
  </section>
</main>
