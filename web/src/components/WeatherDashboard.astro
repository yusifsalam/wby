---
import type { City } from "../lib/cities";
import {
  dayLabel,
  formatMillimeters,
  formatObservedTime,
  formatPercent,
  formatPressure,
  formatSpeed,
  formatTemperature,
  formatVisibility,
  hourLabel,
} from "../lib/formatters";
import { HOURLY_METRICS, type HourlyMetricKey } from "../lib/hourlyMetrics";
import type { DailyForecast, HourlyForecast, WeatherResponse } from "../lib/weatherApi";
import type { CacheResult } from "../lib/weatherCache";
import { symbolAssetFile, symbolDescription } from "../lib/weatherSymbols";
import Footer from "./Footer.astro";
import HourlySettings from "./HourlySettings.astro";
import PrecipitationMap from "./PrecipitationMap.astro";
import TopBar from "./TopBar.astro";
import WeatherSymbol from "./WeatherSymbol.astro";

type Props = {
  city: City;
  cities: readonly City[];
  weather: CacheResult<WeatherResponse>;
};

const { city, cities, weather } = Astro.props;
const data = weather.data;
const current = data.current;
const timeZone = data.timezone || "Europe/Helsinki";
const hourly = data.hourly_forecast.slice(0, 12);
const daily = data.daily_forecast.slice(0, 7);
// Current conditions carry no symbol; use the first forecast hour like the iOS app.
const primarySymbol = hourly[0]?.symbol ?? daily[0]?.symbol;
const hasPrimarySymbol = symbolAssetFile(primarySymbol, "light") != null;
const condition = symbolDescription(primarySymbol);
const lows = daily.map((day) => day.low).filter((value): value is number => value != null);
const highs = daily.map((day) => day.high).filter((value): value is number => value != null);
const overallLow = lows.length > 0 ? Math.min(...lows) : 0;
const overallHigh = highs.length > 0 ? Math.max(...highs) : 1;

const details = [
  ["Wind", formatSpeed(current.wind_speed)],
  ["Gust", formatSpeed(current.wind_gust)],
  ["Humidity", formatPercent(current.humidity)],
  ["Dew point", formatTemperature(current.dew_point)],
  ["Pressure", formatPressure(current.pressure)],
  ["Precip 1h", formatMillimeters(current.precipitation_1h)],
  ["Visibility", formatVisibility(current.visibility)],
  ["Cloud cover", formatPercent(current.cloud_cover)],
];

function tempRangeStyle(day: DailyForecast): string {
  const range = Math.max(overallHigh - overallLow, 1);
  const low = day.low ?? overallLow;
  const high = day.high ?? overallHigh;
  const start = Math.max(0, Math.min(100, ((Math.min(low, high) - overallLow) / range) * 100));
  const width = Math.max(4, Math.min(100 - start, (Math.abs(high - low) / range) * 100));
  return `--range-start:${start}%;--range-width:${width}%`;
}

// 24x24 stroke icons, one per hourly metric row (the row label is visually
// hidden, so the icon carries the meaning at a glance).
const metricIcons: Record<HourlyMetricKey, string> = {
  feels: "M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z",
  wind: "M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2M9.6 4.6A2 2 0 1 1 11 8H2M12.6 19.4A2 2 0 1 0 14 16H2",
  gust: "M3 6h10M3 12h14M3 18h8M17 8l4 4-4 4",
  direction: "M12 19V5M5 12l7-7 7 7",
  precip:
    "M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z",
  pop: "M22 12a10.06 10.06 0 0 0-20 0ZM12 12v8a2 2 0 0 0 4 0M12 2v1",
  humidity:
    "M7 16.3c2.2 0 4-1.8 4-4 0-1.2-.6-2.3-1.7-3.2S7.3 6.8 7 5.3c-.3 1.5-1.1 2.8-2.3 3.8S3 11.1 3 12.3c0 2.2 1.8 4 4 4zM12.6 6.6A11 11 0 0 0 14 3c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a7 7 0 0 1-11.9 5",
  pressure: "m12 14 4-4M3.34 19a10 10 0 1 1 17.32 0",
  cloud: "M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z",
};

// The direction arrow points where the wind blows *to* (FMI reports the
// "from" bearing), matching the convention of the official FMI app.
function metricIconStyle(key: HourlyMetricKey, hour: HourlyForecast): string | undefined {
  if (key !== "direction" || hour.wind_direction == null) return undefined;
  return `transform:rotate(${Math.round(hour.wind_direction + 180) % 360}deg)`;
}
---

<main class="mx-auto flex min-h-screen w-[min(1180px,100%)] flex-col p-6 max-[820px]:p-4">
  <TopBar activeSlug={city.slug} />

  <section class="hero-gradient mb-4.5 grid min-h-77.5 grid-cols-[minmax(0,1fr)_minmax(120px,260px)] items-center gap-7 rounded-lg border border-line p-[clamp(22px,5vw,48px)] shadow-hero max-[820px]:min-h-fit max-[820px]:grid-cols-1">
    <div>
      <p class="mb-3 text-[0.9rem] font-bold text-muted">{data.station.name}</p>
      <h1 class="mb-3 text-[clamp(3rem,10vw,7rem)] font-bold leading-[0.92]">{city.name}</h1>
      <p class="text-[clamp(3.5rem,11vw,8rem)] font-[250] leading-[0.95]">{formatTemperature(current.temperature)}</p>
      {condition && <p class="mt-2.5 text-[clamp(1.15rem,2.2vw,1.5rem)] font-medium">{condition}</p>}
      <p class="mt-1.5 text-muted">
        Feels like {formatTemperature(current.feels_like)} · Observed {formatObservedTime(current.observed_at, timeZone)}
        {weather.state === "stale" ? " · cached data refreshing" : ""}
      </p>
    </div>
    <div class="grid place-items-center max-[820px]:hidden" aria-hidden="true">
      {hasPrimarySymbol ? (
        <WeatherSymbol code={primarySymbol} class="h-auto w-[min(240px,100%)] filter-[drop-shadow(0_18px_24px_rgba(23,33,43,0.16))]" loading="eager" />
      ) : (
        <img class="w-[min(240px,100%)] filter-[drop-shadow(0_18px_24px_rgba(23,33,43,0.16))]" src="/wby-weather.svg" alt="" />
      )}
    </div>
  </section>

  {hourly.length > 0 && (
    <section class="rounded-lg border border-line bg-surface/92 shadow-panel">
      <div class="flex items-center justify-between gap-4 px-4.5 pt-4">
        <h2 class="text-base font-bold">Hourly</h2>
        <div class="flex items-center gap-2">
          <span class="text-muted">{timeZone}</span>
          <HourlySettings />
        </div>
      </div>
      <div class="relative grid grid-cols-12 gap-1.5 px-4.5 pt-3.5 pb-4.5 max-[820px]:auto-cols-[minmax(78px,1fr)] max-[820px]:grid-flow-col max-[820px]:grid-cols-none max-[820px]:overflow-x-auto">
        {hourly.map((hour) => (
          <article class="min-w-0 rounded-lg border border-line bg-surface-strong px-2 py-2.5">
            <time class="block text-[0.85rem] font-extrabold text-teal" datetime={hour.time}>{hourLabel(hour.time, timeZone)}</time>
            <WeatherSymbol code={hour.symbol} class="mt-2 h-9 w-9" />
            <strong class="mt-1.5 mb-1.5 block text-[1.35rem] whitespace-nowrap">{formatTemperature(hour.temperature)}</strong>
            <div class="text-[0.78rem] leading-[1.4] text-muted">
              {HOURLY_METRICS.map((metric) => (
                <span class="hourly-metric items-center gap-1 whitespace-nowrap" data-metric={metric.key} title={metric.label}>
                  <svg class="h-3 w-3 flex-none" style={metricIconStyle(metric.key, hour)} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={metricIcons[metric.key]} />
                  </svg>
                  <span class="sr-only">{metric.label}: </span>
                  {metric.format(hour)}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <PrecipitationMap city={city} />

  <section class="mt-4.5 grid grid-cols-[minmax(0,1.4fr)_minmax(280px,0.8fr)] gap-4.5 max-[820px]:grid-cols-1">
    {daily.length > 0 && (
      <section class="rounded-lg border border-line bg-surface/92 shadow-panel">
        <div class="flex items-center justify-between gap-4 px-4.5 pt-4">
          <h2 class="text-base font-bold">Forecast</h2>
          <span class="text-muted">{daily.length} days</span>
        </div>
        <div class="px-4.5 pt-2.5 pb-4.5">
          {daily.map((day) => (
            <article class="grid min-h-12 grid-cols-[72px_36px_44px_minmax(90px,1fr)_44px_64px] items-center gap-3 border-t border-line first:border-t-0 max-[560px]:grid-cols-[56px_28px_36px_minmax(72px,1fr)_36px]">
              <time class="font-[750]" datetime={day.date}>{dayLabel(day.date, timeZone)}</time>
              <span class="flex h-9 items-center"><WeatherSymbol code={day.symbol} class="h-8 w-8" /></span>
              <span class="text-right">{formatTemperature(day.low)}</span>
              <span class="temp-range" style={tempRangeStyle(day)}></span>
              <span class="text-right font-[750] text-ink">{formatTemperature(day.high)}</span>
              <span class="text-right text-muted max-[560px]:hidden">{formatMillimeters(day.precipitation_mm ?? day.precipitation_1h_sum)}</span>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="rounded-lg border border-line bg-surface/92 shadow-panel">
      <div class="flex items-center justify-between gap-4 px-4.5 pt-4">
        <h2 class="text-base font-bold">Conditions</h2>
        <span class="text-muted">Latest</span>
      </div>
      <dl class="m-0 grid grid-cols-2 gap-2 px-4.5 pt-3.5 pb-4.5 max-[560px]:grid-cols-1">
        {details.map(([label, value]) => (
          <div class="min-h-21 rounded-lg border border-line bg-surface-strong p-3">
            <dt class="mb-2 text-[0.78rem] font-extrabold text-muted">{label}</dt>
            <dd class="m-0 text-[1.2rem] font-[750]">{value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </section>

  <Footer cities={cities} activeSlug={city.slug} />
</main>
