---
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  activeSlug?: string;
};

const { activeSlug } = Astro.props;
const statsActive = activeSlug === "stats";
const mapActive = activeSlug === "map";
const weatherActive = !statsActive && !mapActive;

const navLink =
  "flex-none rounded-lg border border-transparent px-2.5 py-2 text-[0.9rem] font-[650] text-muted hover:border-line hover:bg-surface hover:text-ink aria-[current=page]:border-line aria-[current=page]:bg-surface aria-[current=page]:text-ink";
---

<header
  class="mb-[22px] grid grid-cols-[auto_1fr_auto] items-center gap-5 rounded-2xl border border-line bg-surface/40 px-4 py-2.5 shadow-panel backdrop-blur-md max-[820px]:grid-cols-[1fr_auto]"
>
  <a
    class="inline-flex items-center gap-[9px] font-extrabold tracking-[0.08em] max-[820px]:col-start-1 max-[820px]:row-start-1"
    href="/weather/helsinki"
    aria-label="Weather by Yusif"
  >
    <img class="h-9 w-9" src="/wby-weather.svg" alt="" />
    <span>WBY</span>
  </a>
  <nav
    class="flex justify-end gap-1.5 py-1 max-[820px]:col-span-2 max-[820px]:row-start-2 max-[820px]:justify-start"
    aria-label="Sections"
  >
    <a class={navLink} href="/weather/helsinki" aria-current={weatherActive ? "page" : undefined}>Weather</a>
    <a class={navLink} href="/map" aria-current={mapActive ? "page" : undefined}>Map</a>
    <a class={navLink} href="/stats" aria-current={statsActive ? "page" : undefined}>Stats</a>
  </nav>
  <div class="max-[820px]:col-start-2 max-[820px]:row-start-1 max-[820px]:justify-self-end">
    <ThemeToggle />
  </div>
</header>
