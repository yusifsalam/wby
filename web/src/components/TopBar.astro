---
import type { City } from "../lib/cities";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  cities: readonly City[];
  activeSlug?: string;
};

const { cities, activeSlug } = Astro.props;
---

<header class="grid grid-cols-[auto_1fr_auto] items-center gap-5 pt-2.5 pb-[22px] max-[820px]:grid-cols-[1fr_auto]">
  <a
    class="inline-flex items-center gap-[9px] font-extrabold tracking-[0.08em] max-[820px]:col-start-1 max-[820px]:row-start-1"
    href="/weather/helsinki"
    aria-label="Weather by Yusif"
  >
    <img class="h-9 w-9" src="/wby-weather.svg" alt="" />
    <span>WBY</span>
  </a>
  <nav
    class="flex justify-end gap-1.5 overflow-x-auto py-1 max-[820px]:col-span-2 max-[820px]:row-start-2 max-[820px]:justify-start"
    aria-label="Cities"
  >
    {cities.map((city) => (
      <a
        class="flex-none rounded-lg border border-transparent px-2.5 py-2 text-[0.9rem] font-[650] text-muted hover:border-line hover:bg-surface hover:text-ink aria-[current=page]:border-line aria-[current=page]:bg-surface aria-[current=page]:text-ink"
        href={`/weather/${city.slug}`}
        aria-current={city.slug === activeSlug ? "page" : undefined}
      >
        {city.name}
      </a>
    ))}
    <a
      class="flex-none rounded-lg border border-transparent px-2.5 py-2 text-[0.9rem] font-[650] text-muted hover:border-line hover:bg-surface hover:text-ink aria-[current=page]:border-line aria-[current=page]:bg-surface aria-[current=page]:text-ink"
      href="/stats"
      aria-current={activeSlug === "stats" ? "page" : undefined}
    >
      Stats
    </a>
  </nav>
  <div class="max-[820px]:col-start-2 max-[820px]:row-start-1 max-[820px]:justify-self-end">
    <ThemeToggle />
  </div>
</header>
