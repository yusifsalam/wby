---
// The report's opening collage: an autumn day in Kaisaniemi, with the month on
// a taped scrap and two hand-written notes.
import { goldenParkScene } from "../../../lib/collage/scenes/goldenPark";
import { heroScene } from "../../../lib/collage/scenes/hero";
import CollageSheet from "./CollageSheet.astro";

type Props = {
  art: "rainy-park" | "golden-park";
  title: string;
  notes: [string, string];
};

const { art, title, notes } = Astro.props;
const scene = art === "golden-park" ? goldenParkScene(title, notes) : heroScene(title, notes);
---

<CollageSheet scene={scene} seed={907} narrow="crop" class="cl-hero" parallax />
