---
import type { City } from "../lib/cities";
import type {
  LeaderboardEntry,
  LeaderboardResponse,
  LeaderboardTimeframe,
} from "../lib/weatherApi";
import { LEADERBOARD_TIMEFRAMES } from "../lib/weatherApi";
import type { CacheResult } from "../lib/weatherCache";
import { formatRelativeTime } from "../lib/formatters";
import TopBar from "./TopBar.astro";
import Footer from "./Footer.astro";

type Props = {
  cities: readonly City[];
  timeframe: LeaderboardTimeframe;
  leaderboard: CacheResult<LeaderboardResponse>;
};

const { cities, timeframe, leaderboard } = Astro.props;
const entries = leaderboard.data.leaderboard;

const timeframeLabels: Record<LeaderboardTimeframe, string> = {
  now: "Now",
  "1h": "1h",
  "24h": "24h",
  "3d": "3d",
  "7d": "7d",
};

const typeMeta: Record<string, { title: string; accent: string }> = {
  coldest: { title: "Coldest in Finland", accent: "text-blue" },
  warmest: { title: "Warmest in Finland", accent: "text-coral" },
  windiest: { title: "Windiest in Finland", accent: "text-teal" },
};

function metaFor(entry: LeaderboardEntry): { title: string; accent: string } {
  return typeMeta[entry.type] ?? { title: entry.type, accent: "text-ink" };
}
---

<main class="mx-auto flex min-h-screen w-[min(1180px,100%)] flex-col p-6 max-[820px]:p-4">
  <TopBar activeSlug="stats" />

  <section class="hero-gradient mb-[18px] rounded-lg border border-line p-[clamp(22px,5vw,48px)] shadow-hero">
    <h1 class="mb-4 text-[clamp(2.4rem,8vw,5rem)] font-bold leading-[0.95]">Stats</h1>
    <nav
      class="inline-flex flex-wrap gap-1 rounded-lg border border-line bg-surface/70 p-1"
      aria-label="Timeframe"
    >
      {LEADERBOARD_TIMEFRAMES.map((tf) => (
        <a
          class="rounded-md px-3.5 py-1.5 text-[0.9rem] font-[650] text-muted hover:text-ink aria-[current=page]:bg-surface aria-[current=page]:text-ink aria-[current=page]:shadow-panel"
          href={tf === "now" ? "/stats" : `/stats?timeframe=${tf}`}
          aria-current={tf === timeframe ? "page" : undefined}
        >
          {timeframeLabels[tf]}
        </a>
      ))}
    </nav>
  </section>

  {entries.length > 0 ? (
    <section class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-[18px]">
      {entries.map((entry) => {
        const meta = metaFor(entry);
        return (
          <article class="rounded-lg border border-line bg-surface/92 p-[22px] shadow-panel">
            <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.06em] text-muted">{meta.title}</p>
            <p class="text-[1.4rem] font-[750] leading-tight">{entry.station_name}</p>
            <p class="mt-3 flex items-baseline gap-1.5">
              <span class={`text-[3rem] font-[300] leading-none ${meta.accent}`}>{entry.value.toFixed(1)}</span>
              <span class="text-[1.1rem] text-muted">{entry.unit}</span>
            </p>
            <p class="mt-3 text-[0.9rem] text-muted">
              Observed {formatRelativeTime(entry.observed_at)}
              {leaderboard.state === "stale" ? " · refreshing" : ""}
            </p>
          </article>
        );
      })}
    </section>
  ) : (
    <section class="rounded-lg border border-line bg-surface/92 px-[18px] py-12 text-center shadow-panel">
      <p class="text-muted">No leaderboard data for this timeframe.</p>
    </section>
  )}

  <Footer cities={cities} />
</main>
