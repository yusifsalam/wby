---
import type { ImageMetadata } from "astro";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  article?: {
    title: string;
    published: string;
  };
  image?: ImageMetadata;
};

const {
  title,
  description = "Weather by Yusif.",
  article,
  image,
} = Astro.props;
const url = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="WBY" />
    <meta property="og:title" content={article?.title ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.published} />}
    {image && (
      <>
        <meta property="og:image" content={new URL(image.src, url)} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
      </>
    )}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="icon" type="image/svg+xml" href="/wby-weather.svg" />
    <title>{title}</title>
    <script is:inline>
      // Resolve the theme before first paint to avoid a flash of the wrong mode.
      (() => {
        try {
          const setting = localStorage.getItem("theme") || "auto";
          const dark =
            setting === "dark" ||
            (setting !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
          const root = document.documentElement;
          root.dataset.themeSetting = setting;
          root.classList.toggle("dark", dark);
          // Hourly metric selection: a space-separated token list matched by
          // CSS ([data-hourly-metrics~="key"]) and managed by HourlySettings.
          const metrics = localStorage.getItem("hourly-metrics");
          if (metrics != null) root.dataset.hourlyMetrics = metrics;
          // Unit system: only "imperial" is stored; CSS (.u-metric/.u-imperial)
          // picks which rendered copy of each value shows.
          if (localStorage.getItem("units") === "imperial") root.dataset.units = "imperial";
        } catch {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
