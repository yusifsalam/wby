---
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = "Weather by Yusif.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/wby-weather.svg" />
    <title>{title}</title>
    <script is:inline>
      // Resolve the theme before first paint to avoid a flash of the wrong mode.
      (() => {
        try {
          const setting = localStorage.getItem("theme") || "auto";
          const dark =
            setting === "dark" ||
            (setting !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
          const root = document.documentElement;
          root.dataset.themeSetting = setting;
          root.classList.toggle("dark", dark);
          // Hourly metric selection: a space-separated token list matched by
          // CSS ([data-hourly-metrics~="key"]) and managed by HourlySettings.
          const metrics = localStorage.getItem("hourly-metrics");
          if (metrics != null) root.dataset.hourlyMetrics = metrics;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
