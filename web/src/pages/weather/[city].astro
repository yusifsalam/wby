---
import WeatherDashboard from "../../components/WeatherDashboard.astro";
import WeatherUnavailable from "../../components/WeatherUnavailable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cities, findCityBySlug } from "../../lib/cities";
import { PAGE_CACHE_POLICY, pageCacheControl } from "../../lib/weatherApi";
import { getCityWeather, logPageError, UNAVAILABLE_MESSAGE } from "../../lib/weatherPageData";

const slug = Astro.params.city ?? "";
const city = findCityBySlug(slug);
let result: Awaited<ReturnType<typeof getCityWeather>> | undefined;
let errorMessage = "";

if (!city) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
} else {
  try {
    result = await getCityWeather(city);
    Astro.response.headers.set("Cache-Control", pageCacheControl(PAGE_CACHE_POLICY));
  } catch (error) {
    Astro.response.headers.set("Cache-Control", "no-store");
    Astro.response.status = 503;
  logPageError(`weather page for ${city.slug}`, error);
  errorMessage = UNAVAILABLE_MESSAGE;
  }
}
---

<BaseLayout title={`WBY · ${city?.name ?? "Not found"}`}>
  {city && result ? (
    <WeatherDashboard city={city} cities={cities} weather={result.weather} hourlyWindow={result.hourlyWindow} normals={result.normals} />
  ) : (
    <WeatherUnavailable
      cities={cities}
      title={city ? "Weather unavailable" : "City not found"}
      message={city ? errorMessage : "This city is not part of the cached web forecast yet."}
    />
  )}
</BaseLayout>
