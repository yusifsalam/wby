---
import TopBar from "../components/TopBar.astro";
import UnitText from "../components/UnitText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  TEMP_BAND_WIDTH,
  TEMP_STOPS,
  temperatureRGBA,
  temperatureSteppedRGBA,
} from "../lib/radarFrames";
import "maplibre-gl/dist/maplibre-gl.css";

// Legend tick labels as [metric, imperial] pairs: °C/°F and mm/h ÷ 25.4 → in/h.
const tempTicks = [
  ["-40", "-40"],
  ["-20", "-4"],
  ["0", "32"],
  ["20", "68"],
  ["40", "104"],
];

// Temperature legend bars over the ramp's full span, built from the same
// colorizers as the grid render.
const [tempMin] = TEMP_STOPS[0];
const [tempMax] = TEMP_STOPS[TEMP_STOPS.length - 1];
const tempPct = (t: number) => `${+(((t - tempMin) / (tempMax - tempMin)) * 100).toFixed(2)}%`;
const cssRGB = ([r, g, b]: number[]) => `rgb(${r} ${g} ${b})`;
const tempSmoothBar = `linear-gradient(to right,${TEMP_STOPS.map(([t]) => `${cssRGB(temperatureRGBA(t))} ${tempPct(t)}`).join(",")})`;
const tempBands: string[] = [];
for (let t = tempMin; t < tempMax; t += TEMP_BAND_WIDTH) {
  tempBands.push(`${cssRGB(temperatureSteppedRGBA(t))} ${tempPct(t)} ${tempPct(t + TEMP_BAND_WIDTH)}`);
}
const tempSteppedBar = `linear-gradient(to right,${tempBands.join(",")})`;
const rainTicks = [
  ["0.1", "0.004"],
  ["1", "0.04"],
  ["5", "0.2"],
  ["20+", "0.8+"],
];
const rainSteppedTicks = [
  ["0.1", "0.004"],
  ["0.5", "0.02"],
  ["2.5", "0.1"],
  ["10", "0.4"],
  ["15+", "0.6+"],
];
---

<BaseLayout title="WBY · Map" description="Temperature and precipitation maps for Finland.">
  <main class="relative h-dvh w-full overflow-hidden">
    <div id="map" class="h-full w-full bg-surface"></div>

    <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex flex-col">
      <div class="mx-auto w-[min(1180px,100%)] px-6 pt-6 [&>header]:pointer-events-auto max-[820px]:px-4 max-[820px]:pt-4">
        <TopBar activeSlug="map" />
      </div>

      <div class="mx-auto flex w-[min(1180px,100%)] items-start justify-between gap-3 px-6 max-[820px]:px-4">
        <!-- Layer toggle -->
        <div
          id="layer-toggle"
          class="pointer-events-auto inline-flex gap-1 rounded-lg border border-line bg-surface/90 p-1 shadow-panel backdrop-blur"
        >
          <button
            type="button"
            data-layer="temperature"
            class="rounded-md px-3 py-1.5 text-[0.85rem] font-[650] text-muted hover:text-ink aria-current:bg-page aria-current:text-ink aria-current:shadow-panel max-[560px]:px-2 max-[560px]:py-1 max-[560px]:text-[0.75rem]"
            aria-current="false"
          >Temp<span class="max-[560px]:hidden">erature</span></button>
          <button
            type="button"
            data-layer="precipitation"
            class="rounded-md px-3 py-1.5 text-[0.85rem] font-[650] text-muted hover:text-ink aria-current:bg-page aria-current:text-ink aria-current:shadow-panel max-[560px]:px-2 max-[560px]:py-1 max-[560px]:text-[0.75rem]"
            aria-current="true"
          ><span class="max-[560px]:hidden">Precipitation 1h</span><span class="min-[561px]:hidden">Rain 1h</span></button>
          <button
            type="button"
            data-layer="precipitation12h"
            class="rounded-md px-3 py-1.5 text-[0.85rem] font-[650] text-muted hover:text-ink aria-current:bg-page aria-current:text-ink aria-current:shadow-panel max-[560px]:px-2 max-[560px]:py-1 max-[560px]:text-[0.75rem]"
            aria-current="false"
          ><span class="max-[560px]:hidden">Precipitation 24h</span><span class="min-[561px]:hidden">Rain 24h</span></button>
        </div>

        <div class="pointer-events-auto flex items-center gap-3">
          <!-- Color style for every layer: smooth gradient or stepped bands -->
          <div
            id="ramp-toggle"
            class="inline-flex gap-1 rounded-lg border border-line bg-surface/90 p-1 shadow-panel backdrop-blur"
          >
            <button
              type="button"
              data-ramp="smooth"
              class="rounded-md px-2.5 py-1.5 text-[0.8rem] font-[650] text-muted hover:text-ink aria-current:bg-page aria-current:text-ink aria-current:shadow-panel max-[560px]:px-2 max-[560px]:py-1 max-[560px]:text-[0.7rem]"
              aria-current="true"
            >Smooth</button>
            <button
              type="button"
              data-ramp="stepped"
              class="rounded-md px-2.5 py-1.5 text-[0.8rem] font-[650] text-muted hover:text-ink aria-current:bg-page aria-current:text-ink aria-current:shadow-panel max-[560px]:px-2 max-[560px]:py-1 max-[560px]:text-[0.7rem]"
              aria-current="false"
            >Stepped</button>
          </div>

          <!-- Opacity -->
          <div class="flex items-center gap-2 rounded-lg border border-line bg-surface/90 px-3 py-2 text-[0.8rem] font-[650] text-muted shadow-panel backdrop-blur max-[560px]:px-2 max-[560px]:py-1.5">
            <span class="max-[560px]:hidden">Opacity</span>
            <input id="opacity" type="range" min="0" max="100" value="80" class="w-24 accent-teal max-[560px]:w-16" aria-label="Overlay opacity" />
          </div>
        </div>
      </div>
    </div>

    <!-- Legend -->
    <div class="pointer-events-none absolute bottom-16 left-3 z-10 rounded-lg border border-line bg-surface/90 px-3 py-2 shadow-panel backdrop-blur">
      <div id="legend-temperature" hidden>
        <p class="mb-1 text-[0.7rem] font-extrabold uppercase tracking-[0.06em] text-muted">Temperature <UnitText metric="°C" imperial="°F" /></p>
        <div id="legend-temperature-smooth" class="h-2 w-48 rounded" style={`background:${tempSmoothBar}`}></div>
        <div id="legend-temperature-stepped" class="h-2 w-48 rounded" style={`background:${tempSteppedBar}`} hidden></div>
        <div class="mt-0.5 flex w-48 justify-between text-[0.65rem] font-[650] text-muted">
          {tempTicks.map(([metric, imperial]) => <span><UnitText metric={metric} imperial={imperial} /></span>)}
        </div>
      </div>
      <!-- Shared by both precipitation layers: the 12h grid ramp (PRECIP_STOPS
           below) mirrors the FMI WMS radar palette of the 1h PNGs. -->
      <div id="legend-precipitation">
        <p class="mb-1 text-[0.7rem] font-extrabold uppercase tracking-[0.06em] text-muted">Rain <UnitText metric="mm/h" imperial="in/h" /></p>
        <div class="h-2 w-48 rounded" style="background:linear-gradient(to right,#a8e0ff,#3fa0ff,#1436ff,#8b00ff,#ff00aa)"></div>
        <div class="mt-0.5 flex w-48 justify-between text-[0.65rem] font-[650] text-muted">
          {rainTicks.map(([metric, imperial]) => <span><UnitText metric={metric} imperial={imperial} /></span>)}
        </div>
      </div>
      <!-- FMI stepped classes (Mobile_dark): swatch colors and thresholds from
           the WMS legend, shown when the FMI ramp is active. -->
      <div id="legend-precipitation-stepped" hidden>
        <p class="mb-1 text-[0.7rem] font-extrabold uppercase tracking-[0.06em] text-muted">Rain <UnitText metric="mm/h" imperial="in/h" /></p>
        <div class="flex h-2 w-48 overflow-hidden rounded">
          <span class="flex-1" style="background:#adf3fa"></span>
          <span class="flex-1" style="background:#86bef3"></span>
          <span class="flex-1" style="background:#5f8aec"></span>
          <span class="flex-1" style="background:#3955e5"></span>
          <span class="flex-1" style="background:#1421de"></span>
          <span class="flex-1" style="background:#8238ec"></span>
          <span class="flex-1" style="background:#b943f4"></span>
          <span class="flex-1" style="background:#f14efb"></span>
        </div>
        <div class="mt-0.5 flex w-48 justify-between text-[0.65rem] font-[650] text-muted">
          {rainSteppedTicks.map(([metric, imperial]) => <span><UnitText metric={metric} imperial={imperial} /></span>)}
        </div>
      </div>
    </div>

    <!-- Time scrubber -->
    <div class="absolute bottom-3 left-3 right-3 z-10 flex items-center gap-3 rounded-lg border border-line bg-surface/90 px-3 py-2 shadow-panel backdrop-blur">
      <button
        id="play"
        type="button"
        aria-pressed="false"
        aria-label="Play forecast animation"
        class="flex-none rounded-md px-2 py-0.5 text-[1rem] leading-none text-ink hover:text-teal"
      >▶</button>
      <span class="flex-none text-[0.8rem] font-[650] text-muted max-[560px]:hidden">Time</span>
      <input id="time" type="range" value="0" class="min-w-0 flex-1 accent-teal" aria-label="Forecast time" />
      <span id="time-label" class="w-36 flex-none whitespace-nowrap text-right text-[0.85rem] font-[650] text-ink tabular-nums max-[560px]:w-20 max-[560px]:text-[0.7rem]">Now</span>
    </div>
  </main>
</BaseLayout>

<script>
  import * as maplibregl from "maplibre-gl";
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import { isMapLayer, type MapLayer as Layer } from "../lib/mapLayers";
  import {
    bakeOverlayImage,
    basemapStyleFor,
    type Corners,
    FINLAND_CORNERS,
    type Frame,
    fallbackManifest,
    fixedFrame,
    formatFrameClock,
    formatFrameOffset,
    frameTimeParam,
    loadImage,
    loadManifest,
    type Manifest,
    observeTheme,
    overlayBeforeId,
    TRANSPARENT_PNG,
    tuneBasemap,
  } from "../lib/mapOverlay";
  import {
    parseRamp,
    storedOpacity,
    storedRamp,
    storeOpacity,
    storeRamp,
  } from "../lib/mapSettings";
  import {
    createRadarFrames,
    type FieldGrid,
    gridCorners,
    type MapRamp,
    PRECIP_GRID_QUERY,
    precipitationRampRGBA,
    rasterizeGrid,
    temperatureRampRGBA,
  } from "../lib/radarFrames";

  maplibregl.setWorkerUrl(workerUrl);

  // Frame manifest (see lib/mapOverlay): starts on the client-derived fallback
  // schedule and is replaced once the server manifest lands.
  let manifest: Manifest = fallbackManifest();

  // The active layer is mirrored to the ?layer= query param so a shared URL
  // reopens on the same map. Precipitation is the default and omits the param.
  // The forecast layer keeps its precipitation12h internal/API id but reads and
  // writes the param as precipitation24h; old precipitation12h URLs still work.
  const DEFAULT_LAYER: Layer = "precipitation";
  function layerFromURL(): Layer {
    let raw = new URLSearchParams(window.location.search).get("layer") ?? "";
    if (raw === "precipitation24h") raw = "precipitation12h";
    return isMapLayer(raw) ? raw : DEFAULT_LAYER;
  }
  function writeLayerToURL(next: Layer) {
    const url = new URL(window.location.href);
    if (next === DEFAULT_LAYER) url.searchParams.delete("layer");
    else
      url.searchParams.set(
        "layer",
        next === "precipitation12h" ? "precipitation24h" : next,
      );
    history.replaceState(null, "", url);
  }

  let layer: Layer = layerFromURL();
  let opacity = storedOpacity();
  const opacityInput = document.getElementById("opacity") as HTMLInputElement;
  opacityInput.value = String(Math.round(opacity * 100));
  // Index into the active layer's frame list. nowIndex means the live frame.
  let frameIndex = manifest[layer].nowIndex;

  const map = new maplibregl.Map({
    container: "map",
    style: basemapStyleFor(),
    center: [26, 64.5],
    zoom: 4.5,
    attributionControl: {
      compact: true,
      customAttribution:
        '<a href="https://en.ilmatieteenlaitos.fi/open-data-licence">Weather data © FMI, CC BY 4.0</a>',
    },
  });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "bottom-right");

  // The frame instant for the active scrubber position, or null for the live
  // "now" frame.
  const timeParam = () => frameTimeParam(manifest[layer], frameIndex);

  // The active color style for every layer, mirrored to ?ramp= like the layer.
  // Ramp and opacity persist across visits (lib/mapSettings); a ?ramp= URL
  // still wins for the ramp so shared links open as intended.
  function initialRamp(): MapRamp {
    const fromURL = new URLSearchParams(window.location.search).get("ramp");
    return fromURL === null ? storedRamp() : parseRamp(fromURL);
  }
  function writeRamp(next: MapRamp) {
    const url = new URL(window.location.href);
    if (next === "smooth") url.searchParams.delete("ramp");
    else url.searchParams.set("ramp", next);
    history.replaceState(null, "", url);
    storeRamp(next);
  }
  let ramp: MapRamp = initialRamp();

  // The ±1h radar layer's frames (see lib/radarFrames).
  const radar = createRadarFrames(() => ramp);

  // The layers rendered client-side from the GRIB grid JSON.
  type GridLayer = Exclude<Layer, "precipitation">;

  function gridFrameURL(l: GridLayer, at: string): string {
    return l === "temperature"
      ? `/api/map/temperature-samples?at=${encodeURIComponent(at)}`
      : `/api/map/precipitation-forecast?${PRECIP_GRID_QUERY}&time=${encodeURIComponent(at)}`;
  }

  // The GRIB grid is whole-Finland and independent of the viewport, so a given
  // (layer, instant) always rasterizes to the same texture. Memoize so panning
  // and re-scrubbing to a visited frame skip both the fetch and the synchronous
  // PNG encode. `null` records a known GRIB miss.
  const gridFrameCache = new Map<string, Frame | null>();

  async function fetchGridFrame(l: GridLayer, at: string): Promise<Frame | null> {
    const style = ramp;
    const res = await fetch(gridFrameURL(l, at));
    // 404 = the GRIB source is unconfigured or the field isn't available yet;
    // a known miss rather than a transient error.
    if (res.status === 404) return null;
    if (!res.ok) throw new Error(`grid fetch failed: ${res.status}`);
    const data = (await res.json()) as { grid?: FieldGrid | null };
    if (!data.grid || data.grid.values.length === 0) return null;
    const rgba =
      l === "temperature" ? temperatureRampRGBA(style) : precipitationRampRGBA(style);
    return { url: rasterizeGrid(data.grid, rgba), corners: gridCorners(data.grid) };
  }

  // Rasterized frames bake the ramp in, so cache keys carry the active ramp —
  // switching styles re-rasterizes instead of serving stale colors.
  function gridFrameKey(l: GridLayer, at: string): string {
    return `${l}|${at}|${ramp}`;
  }

  // Fetch the GRIB grid JSON for the active frame and render it client-side —
  // for every frame including "now" (the server serves GRIB from the current
  // hour onward). Uses the frame's real instant (not timeParam, which omits the
  // time for "now"). Returns null on a GRIB miss so the caller can fall back.
  async function gridFrame(l: GridLayer): Promise<Frame | null> {
    const at = manifest[l].times[frameIndex];
    if (!at) return null;
    const key = gridFrameKey(l, at);
    const cached = gridFrameCache.get(key);
    if (cached !== undefined) return cached;
    const frame = await fetchGridFrame(l, at);
    gridFrameCache.set(key, frame);
    return frame;
  }

  // Warm caches for every frame within `span` steps of `center` so scrubbing and
  // animation land on already-fetched data instead of a fresh round-trip. The
  // window wraps around the list (modulo length) so the loop-restart frame is
  // warm before playback jumps back to it — otherwise the wrap stalls on a live
  // fetch. Grid layers warm gridFrameCache (GRIB grid); the radar layer warms
  // its own grid caches. Fire-and-forget; failures fall back to a live fetch
  // on demand.
  function prefetchAround(center: number, span: number) {
    const frames = manifest[layer];
    const len = frames.times.length;
    for (let offset = -span; offset <= span; offset++) {
      if (offset === 0) continue;
      const idx = ((center + offset) % len + len) % len;
      if (idx === center) continue;
      if (layer === "precipitation") {
        radar.prefetch(frames, idx);
        continue;
      }
      const at = frames.times[idx];
      const key = gridFrameKey(layer, at);
      if (gridFrameCache.has(key)) continue;
      fetchGridFrame(layer, at)
        .then((frame) => gridFrameCache.set(key, frame))
        .catch(() => {});
    }
  }

  async function buildFrame(): Promise<Frame> {
    // The grid layers render the dense GRIB grid directly (every frame, now
    // included); the 12h layer has no PNG fallback, so a miss shows an empty
    // frame rather than leaving another layer's raster on screen. The ±1h
    // layer renders past/now frames from the radar observation grid and
    // future frames from the extrapolation nowcast grid, falling back to the
    // server PNG on a miss.
    if (layer === "precipitation") {
      return radar.frameAt(manifest.precipitation, frameIndex);
    }
    const grid = await gridFrame(layer);
    if (grid) return grid;
    if (layer === "precipitation12h") {
      return { url: TRANSPARENT_PNG, corners: FINLAND_CORNERS };
    }
    return fixedFrame("temperature", timeParam());
  }

  // A single persistent image source + raster layer, whose texture we swap per
  // frame via updateImage — sataako-fi's model. The layer opacity is constant
  // (never two translucent layers stacked), so there's no brightness pulse; and
  // MapLibre keeps the current texture on screen until the next image decodes, so
  // a swap never dips through to the basemap. updateImage repaints reliably on a
  // URL change in maplibre-gl v5, and it also accepts new coordinates, which the
  // temperature forecast grid needs (its extent differs from the fixed PNG one).
  const OVERLAY_SRC = "overlay-src";
  const OVERLAY_LAYER = "overlay-layer";

  // Baked (decoded, Mercator-canvas) overlay data URLs, memoised by the source
  // frame url so scrubbing/animation re-render each unique frame once. Grid
  // data URLs (warped, temperature also clipped) and radar PNG urls (copied
  // verbatim) all flow through it. Each source url belongs to one layer, so the
  // bake options are stable per key.
  const bakedFrameCache = new Map<string, string>();

  async function bakedFrameUrl(
    url: string,
    corners: Corners,
    opts: { warp?: boolean; clip?: boolean },
  ): Promise<string> {
    const cached = bakedFrameCache.get(url);
    if (cached !== undefined) return cached;
    const baked = bakeOverlayImage(await loadImage(url), corners, opts);
    bakedFrameCache.set(url, baked);
    return baked;
  }

  function ensureOverlayLayer() {
    if (!map.getSource(OVERLAY_SRC)) {
      map.addSource(OVERLAY_SRC, {
        type: "image",
        url: TRANSPARENT_PNG,
        coordinates: FINLAND_CORNERS,
      });
      map.addLayer(
        {
          id: OVERLAY_LAYER,
          type: "raster",
          source: OVERLAY_SRC,
          paint: { "raster-opacity": opacity, "raster-fade-duration": 0 },
        },
        overlayBeforeId(map, layer),
      );
    }
  }

  // True once the style spec is parsed (the `style.load` event) and layers can be
  // safely added/mutated. NOT map.isStyleLoaded(), which stays false while base
  // tiles or our overlay image are still loading — that gate never opens during
  // initial load or animation, so refreshOverlay/autostart would bail forever.
  let styleReady = false;

  // Bumped on every refresh so an async frame build (grid fetch) that resolves
  // after a newer scrub/pan is discarded instead of clobbering the latest frame.
  let refreshSeq = 0;

  async function refreshOverlay() {
    if (!styleReady) return;
    ensureOverlayLayer();
    const seq = ++refreshSeq;

    let view: Frame;
    let imageUrl: string;
    try {
      view = await buildFrame();
      // Grid renders rasterize linear in latitude and need the Mercator warp
      // (the frame says so itself where a layer mixes grid and PNG frames);
      // the radar PNG is already Mercator. Temperature is a land field, so clip
      // it to the Finland outline; rain is real over the sea, so both
      // precipitation layers bake unclipped over their full extent.
      imageUrl = await bakedFrameUrl(view.url, view.corners, {
        warp: view.warp ?? layer !== "precipitation",
        clip: layer === "temperature",
      });
    } catch (err) {
      console.error("overlay refresh failed", err);
      return;
    }
    if (seq !== refreshSeq || !styleReady) return;

    const src = map.getSource(OVERLAY_SRC) as maplibregl.ImageSource | undefined;
    if (!src) return;
    src.updateImage({ url: imageUrl, coordinates: view.corners });
  }

  const debounce = (fn: () => void, ms: number) => {
    let timer: ReturnType<typeof setTimeout>;
    return () => {
      clearTimeout(timer);
      timer = setTimeout(fn, ms);
    };
  };
  const refreshDebounced = debounce(refreshOverlay, 250);

  // The style is (re)loaded on init and whenever we switch light/dark, which
  // drops custom sources; refreshOverlay recreates the overlay layer and repaints
  // the current frame.
  map.on("style.load", () => {
    styleReady = true;
    tuneBasemap(map);
    refreshOverlay();
    maybeAutostart();
  });

  // Layer toggle
  const toggle = document.getElementById("layer-toggle");
  const rampToggle = document.getElementById("ramp-toggle") as HTMLElement;
  const legendTemp = document.getElementById("legend-temperature") as HTMLElement;
  const legendTempSmooth = document.getElementById("legend-temperature-smooth") as HTMLElement;
  const legendTempStepped = document.getElementById("legend-temperature-stepped") as HTMLElement;
  const legendPrecip = document.getElementById("legend-precipitation") as HTMLElement;
  const legendPrecipStepped = document.getElementById("legend-precipitation-stepped") as HTMLElement;
  // Mirror the active layer and ramp to the toggle buttons and legends. Called
  // on load too, so a ?layer= or ?ramp= URL flips the statically-rendered
  // defaults. Both precipitation layers share one legend; the active ramp picks
  // which precipitation legend and temperature bar show.
  function syncLayerUI() {
    for (const b of toggle?.querySelectorAll<HTMLButtonElement>("button[data-layer]") ?? []) {
      b.setAttribute("aria-current", String(b.dataset.layer === layer));
    }
    for (const b of rampToggle.querySelectorAll<HTMLButtonElement>("button[data-ramp]")) {
      b.setAttribute("aria-current", String(b.dataset.ramp === ramp));
    }
    legendTemp.hidden = layer !== "temperature";
    legendTempSmooth.hidden = ramp === "stepped";
    legendTempStepped.hidden = ramp !== "stepped";
    legendPrecip.hidden = layer === "temperature" || ramp === "stepped";
    legendPrecipStepped.hidden = layer === "temperature" || ramp !== "stepped";
  }
  syncLayerUI();

  rampToggle.querySelectorAll<HTMLButtonElement>("button[data-ramp]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = btn.dataset.ramp as MapRamp;
      if (next === ramp) return;
      ramp = next;
      writeRamp(ramp);
      syncLayerUI();
      // Frame caches are keyed by ramp, so a style switch re-rasterizes on
      // demand; warm the nearby frames and repaint the current one.
      prefetchAround(frameIndex, 2);
      refreshOverlay();
    });
  });
  toggle?.querySelectorAll<HTMLButtonElement>("button[data-layer]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = btn.dataset.layer as Layer;
      if (next === layer) return;
      userInteracted = true;
      layer = next;
      writeLayerToURL(layer);
      syncLayerUI();
      // Temperature and precipitation slot at different depths (below vs above
      // the water fill), so restack the existing overlay for the new layer.
      if (map.getLayer(OVERLAY_LAYER)) {
        map.moveLayer(OVERLAY_LAYER, overlayBeforeId(map, layer));
      }
      stopPlaying();
      applyTimeRange();
      prefetchAround(frameIndex, 2);
      refreshOverlay();
    });
  });

  // Opacity
  opacityInput.addEventListener("input", () => {
    opacity = Number(opacityInput.value) / 100;
    if (map.getLayer(OVERLAY_LAYER)) {
      map.setPaintProperty(OVERLAY_LAYER, "raster-opacity", opacity);
    }
  });
  opacityInput.addEventListener("change", () => {
    storeOpacity(opacity);
  });

  // Time scrubber. The slider indexes into the active layer's frame list, with
  // its value pinned at the "now" frame; the label shows the offset from now plus
  // the frame's real clock time.
  const timeInput = document.getElementById("time") as HTMLInputElement;
  const timeLabel = document.getElementById("time-label") as HTMLElement;

  const formatOffset = () => formatFrameOffset(manifest[layer], frameIndex);
  const formatClock = () => formatFrameClock(manifest[layer], frameIndex);

  function updateTimeLabel() {
    const clock = formatClock();
    // Offset ("+22h · ") is hidden on mobile, where it also made the label —
    // and thus the flex slider — resize on every scrub. Values come from
    // controlled formatters, so innerHTML is safe here.
    timeLabel.innerHTML = clock
      ? `<span class="max-[560px]:hidden">${formatOffset()} · </span>${clock}`
      : formatOffset();
  }

  // Re-point the slider at the active layer's frame list and reset to "now".
  function applyTimeRange() {
    const frames = manifest[layer];
    timeInput.min = "0";
    timeInput.max = String(frames.times.length - 1);
    timeInput.step = "1";
    frameIndex = frames.nowIndex;
    timeInput.value = String(frameIndex);
    updateTimeLabel();
  }

  timeInput.addEventListener("input", () => {
    userInteracted = true;
    stopPlaying();
    frameIndex = Number(timeInput.value);
    updateTimeLabel();
    prefetchAround(frameIndex, 2);
    refreshDebounced();
  });

  // Radar-loop playback: auto-advance through the frame window at a uniform
  // cadence, wrapping at the end. Frames are prefetched a few steps ahead (the
  // window wraps too), so playback stays smooth across the loop restart. After
  // MAX_LOOPS full cycles playback pauses on the "now" frame; ▶ restarts.
  const FRAME_MS = 600;
  const MAX_LOOPS = 3;
  const playButton = document.getElementById("play") as HTMLButtonElement;
  let playing = false;
  let playTimer: ReturnType<typeof setTimeout> | undefined;
  let loopsDone = 0;
  // Autostart the loop once on load — but only after both the map style and the
  // manifest are ready (whichever lands last triggers it), and never if the user
  // has already driven the controls (play/pause, scrub, layer switch).
  let autostarted = false;
  let userInteracted = false;

  function maybeAutostart() {
    if (autostarted || userInteracted || !styleReady) return;
    autostarted = true;
    startPlaying();
  }

  function setFrameIndex(idx: number) {
    frameIndex = idx;
    timeInput.value = String(idx);
    updateTimeLabel();
  }

  function animateTick() {
    const frames = manifest[layer];
    const next = frameIndex + 1 >= frames.times.length ? 0 : frameIndex + 1;
    setFrameIndex(next);
    prefetchAround(next, 3);
    refreshOverlay();
    // A cycle ends each time the playhead comes back around to "now".
    if (next === frames.nowIndex && ++loopsDone >= MAX_LOOPS) {
      stopPlaying();
      return;
    }
    playTimer = setTimeout(animateTick, FRAME_MS);
  }

  function startPlaying() {
    if (playing) return;
    playing = true;
    loopsDone = 0;
    playButton.setAttribute("aria-pressed", "true");
    playButton.textContent = "⏸";
    prefetchAround(frameIndex, 3);
    playTimer = setTimeout(animateTick, FRAME_MS);
  }

  function stopPlaying() {
    if (!playing) return;
    playing = false;
    clearTimeout(playTimer);
    playButton.setAttribute("aria-pressed", "false");
    playButton.textContent = "▶";
  }

  playButton.addEventListener("click", () => {
    userInteracted = true;
    if (playing) stopPlaying();
    else startPlaying();
  });

  // Fetch the frame manifest, then re-anchor the scrubber to real frame times.
  loadManifest().then((loaded) => {
    manifest = loaded;
    applyTimeRange();
    prefetchAround(frameIndex, 2);
    maybeAutostart();
  });
  applyTimeRange();

  // Follow the app-wide light/dark theme toggle. setStyle drops custom layers
  // until style.load refires; block overlay mutation until then.
  observeTheme(() => {
    styleReady = false;
    map.setStyle(basemapStyleFor());
  });
</script>
