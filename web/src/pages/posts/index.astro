---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import TopBar from "../../components/TopBar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cities } from "../../lib/cities";
import { publishedDate } from "../../lib/formatters";

export const prerender = true;

const infographics = new Set(
  Object.keys(import.meta.glob("../../content/posts/*/*/*-infographic.svg")).map((file) =>
    file.replace(/^\.\.\/\.\.\/content\/posts\/(\d+)\/(\d+)\/(.+)-\1-\2-infographic\.svg$/, "$1/$2/$3"),
  ),
);

const posts = (await getCollection("posts", (post) => import.meta.env.DEV || !post.data.draft)).sort((a, b) =>
  b.data.published.localeCompare(a.data.published),
);
---

<BaseLayout title="WBY · Posts">
  <main class="mx-auto flex min-h-screen w-[min(1180px,100%)] flex-col p-6 max-[820px]:p-4">
    <TopBar activeSlug="posts" />

    <section class="hero-gradient mb-4.5 rounded-lg border border-line p-[clamp(22px,5vw,48px)] shadow-hero">
      <h1 class="text-[clamp(2.4rem,8vw,5rem)] font-bold leading-[0.95]">Posts</h1>
    </section>

    {posts.length > 0 ? (
      <section class="mb-10 grid gap-4.5">
        {posts.map((post) => (
          <article class="group relative rounded-lg border border-line bg-surface/92 px-[clamp(18px,4vw,32px)] py-[clamp(18px,3.5vw,28px)] shadow-panel hover:bg-surface-strong has-[.card-link:focus-visible]:outline-2 has-[.card-link:focus-visible]:outline-offset-2 has-[.card-link:focus-visible]:outline-teal">
            <p class="text-[0.9rem] font-bold text-teal">
              {post.data.kicker}
              {post.data.draft && <span class="text-muted"> · Draft</span>}
            </p>
            <h2 class="mt-2 text-[clamp(1.5rem,3.5vw,2.2rem)] leading-tight font-bold group-hover:underline group-hover:decoration-line group-hover:underline-offset-4">
              <a
                class="card-link outline-none after:absolute after:inset-0 after:rounded-lg"
                href={post.data.draft ? `/preview/posts/${post.id}` : `/posts/${post.id}`}
              >
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 max-w-[72ch] leading-normal text-muted">{post.data.description}</p>
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.85rem] font-[550] text-muted">
              <time datetime={post.data.published}>{publishedDate(post.data.published)}</time>
              {!post.data.draft && infographics.has(post.id) && (
                <a
                  class="relative z-10 underline decoration-line underline-offset-2 hover:text-teal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
                  href={`/infographics/${post.id}`}
                >
                  Infographic
                </a>
              )}
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="mb-10 rounded-lg border border-line bg-surface/92 px-4.5 py-12 text-center shadow-panel">
        <p class="text-muted">No posts yet.</p>
      </section>
    )}

    <Footer cities={cities} />
  </main>
</BaseLayout>
