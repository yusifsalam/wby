# Live-reload image for local development. The app/ source is bind-mounted at
# runtime (see docker-compose.dev.yml); uvicorn --reload restarts on file
# change. uvicorn[standard] bundles watchfiles for the file watcher. Not used
# in production.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
ENV GRIB_DATA_DIR=/data \
    PORT=9090
EXPOSE 9090
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --reload"]
